# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) and fill in the public key.
#
# Get keys from: Supabase Dashboard -> Project Settings -> API Keys
#
# FRONTEND (Public Browser Variables — bundled by Vite):
#   - Preferred: VITE_SUPABASE_PUBLISHABLE_KEY (new `sb_publishable_...` key)
#   - Legacy fallback: VITE_SUPABASE_ANON_KEY (used when VITE_SUPABASE_PUBLISHABLE_KEY
#     is absent or empty; accepts `sb_publishable_...` or legacy `anon` JWT)
#
# BACKEND (Server-Only Cloudflare Pages Secrets for `/api/quote` — NEVER prefix with VITE_):
#   - SUPABASE_URL=https://smdxbjkeruhjerbrdply.supabase.co
#   - Preferred: SUPABASE_SECRET_KEY (new `sb_secret_...` key)
#   - Legacy fallback: SUPABASE_SERVICE_ROLE_KEY (legacy `service_role` JWT, used when
#     SUPABASE_SECRET_KEY is absent or empty)
#
# NEVER put `SUPABASE_SECRET_KEY`, `SUPABASE_SERVICE_ROLE_KEY`, `sb_secret_...`,
# `service_role` JWTs, database passwords, or access tokens in any VITE_ variable —
# everything prefixed VITE_ is bundled into public JavaScript sent to every visitor.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://smdxbjkeruhjerbrdply.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Legacy fallback (uncomment only if not using VITE_SUPABASE_PUBLISHABLE_KEY):
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY
