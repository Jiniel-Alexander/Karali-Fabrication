# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (git-ignored) and fill in the key.
#
# Get the key from: Supabase Dashboard -> Project Settings -> API Keys
#   Use the PUBLIC "anon" key (legacy JWT) or the "publishable" key (sb_publishable_...).
#
# NEVER put the service_role / secret key (sb_secret_...), database password
# or access tokens in any VITE_ variable — everything prefixed VITE_ is
# bundled into the public JavaScript sent to every visitor.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://smdxbjkeruhjerbrdply.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
